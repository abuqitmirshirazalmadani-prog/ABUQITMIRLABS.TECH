{
  "name": "abuqitmirlabs-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "audit:seo": "node scripts/audit-seo-quality.cjs",
    "report:seo": "tsx scripts/seo-report.ts || true",
    "prerender": "node scripts/prerender.cjs",
    "generate:logos": "node scripts/generate-logos.js && node scripts/generate-social-assets.js && node scripts/generate-ecommerce-banner.cjs && node scripts/generate-skills-academy-banner.cjs && node scripts/generate-blog-covers.cjs",
    "build": "vite build && esbuild src/ssr-entry.tsx --bundle --platform=node --format=cjs --packages=external --alias:@=./src --outfile=dist/ssr-bundle.cjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^2.0.111",
    "@studio-freight/react-lenis": "^0.0.47",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "jsdom": "^29.1.1",
    "jspdf": "^4.2.1",
    "locomotive-scroll": "^5.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next-sitemap": "^4.2.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-icon-cloud": "^4.1.7",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.9",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.165.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
